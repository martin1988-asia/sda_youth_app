rules_version = '2';
service cloud.firestore {

  function isAuthenticated() {
    return request.auth != null;
  }

  function isAdmin() {
    return request.auth != null && request.auth.token.role == "admin";
  }

  function isSystem() {
    return request.auth != null && request.auth.token.admin == true;
  }

  match /databases/{database}/documents {

    // ✅ ✅ ✅ REELS (FULLY FIXED FOR YOUR CODE)
    match /reels/{reelId} {

      allow read: if isAuthenticated();

      // ✅ REQUIRED for tracking (_track())
      allow update: if isAuthenticated();

      allow create: if isAuthenticated();

      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // ✅ COMMENTS (used in CommentsSheet)
      match /comments/{commentId} {
        allow read, write: if isAuthenticated();
      }

      // ✅ REACTIONS (used in _like())
      match /reactions/{reactionId} {
        allow read, write: if isAuthenticated();
      }

      // ✅ HEATMAP (used in _track())
      match /heatmap/{heatId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ✅ ✅ ✅ USERS (CRITICAL FOR REELS TRACKING)
    match /users/{userId} {

      allow read: if isAuthenticated();

      // ✅ only owner can write
      allow write: if isAuthenticated() &&
        request.auth.uid == userId;

      // ✅ your interests system (_track)
      match /interests/{docId} {
        allow read, write: if isAuthenticated() &&
          request.auth.uid == userId;
      }

      // ✅ follow system (_toggleFollow)
      match /following/{docId} {
        allow read, write: if isAuthenticated() &&
          request.auth.uid == userId;
      }

      match /notifications/{notifId} {
        allow read, write: if isAuthenticated() &&
          request.auth.uid == userId;
      }

      match /fcmTokens/{docId} {
        allow read, write: if isAuthenticated() &&
          request.auth.uid == userId;
      }
    }

    // ✅ ✅ ✅ CHAT SYSTEM (SAFE)
    match /chats/{chatId} {

      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ✅ POSTS
    match /posts/{postId} {
      allow read, write: if isAuthenticated();

      match /comments/{commentId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ✅ COMMUNITY POSTS
    match /community_posts/{postId} {
      allow read, write: if isAuthenticated();

      match /comments/{commentId} {
        allow read, write: if isAuthenticated();
      }

      match /likes/{likeId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ✅ OTHER COLLECTIONS (kept working)
    match /connections/{connId} {
      allow read, write: if isAuthenticated();
    }

    match /favorites/{favId} {
      allow read, write: if isAuthenticated();
    }

    match /feedback/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /support/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /questions/{questionId} {
      allow read, write: if isAuthenticated();
    }

    match /answers/{answerId} {
      allow read, write: if isAuthenticated();
    }

    match /gamification/{badgeId} {
      allow read: if isAuthenticated();
      allow create: if isSystem();
      allow update, delete: if false;
    }

    match /media/{mediaId} {
      allow read, write: if isAuthenticated();
    }

    match /testimonies/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /resources/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /courses/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ✅ ✅ ✅ GLOBAL SAFETY NET (prevents any hidden permission errors)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
